{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src", // <-- ADDED: Source files are in the 'src' folder
    "outDir": "./dist", // <-- ADDED: Compiled output goes to 'dist'

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",

    // ADDED: Include 'node' types for process, console, etc.
    "types": ["node"],
    "lib": ["esnext"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options (These are generally good)
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },

  // <-- CRITICAL ADDITION: This tells TypeScript what files to check -->
  "include": [
    "src/**/*",
    "eslint.config.js", // Must be included
    "src/middleware/**/*", // Ensure this is included for the middleware file
    "*.ts", // Include any loose TS files in the root if necessary
    "*.js" // Include all JS files in the root (like the config)
  ],

  // <-- RECOMMENDED ADDITION: Exclude output directories and libraries -->
  "exclude": ["node_modules", "dist"]
}
